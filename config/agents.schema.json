{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "config/agents.schema.json",
  "title": "KodeHold Agent Configuration Schema",
  "description": "Validates config/agents.yaml — agent definitions, defaults, permissions, triggers, and constraints",
  "type": "object",
  "properties": {
    "defaults": { "$ref": "#/definitions/agentDefaultsConfig" },
    "agents": {
      "type": "array",
      "description": "List of all agent configurations",
      "items": { "$ref": "#/definitions/agentConfig" },
      "minItems": 1,
      "uniqueItems": true
    }
  },
  "required": ["agents"],
  "additionalProperties": false,
  "definitions": {
    "agentConfig": {
      "type": "object",
      "description": "Configuration for a single agent. Requires name and description.",
      "properties": {
        "name": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9-]*$",
          "description": "Agent identifier, lowercase kebab-case. Must match directory name."
        },
        "description": {
          "type": "string",
          "description": "Human-readable description of the agent's role."
        },
        "mode": {
          "type": "string",
          "enum": ["all", "subagent"],
          "description": "Agent mode: all (autonomous) or subagent (called by other agents)."
        },
        "hidden": {
          "type": "boolean",
          "description": "If true, agent is not listed in auto-discovery."
        },
        "model": {
          "type": "string",
          "description": "Model override for this agent. Format: <provider>/<model-id>."
        },
        "triggers": {
          "type": "array",
          "description": "Keywords/phrases that activate this agent.",
          "items": { "type": "string" },
          "uniqueItems": true
        },
        "tags": {
          "type": "array",
          "description": "Arbitrary tags for categorization and filtering.",
          "items": { "type": "string" },
          "uniqueItems": true
        },
        "permission": { "$ref": "#/definitions/permissionConfig" },
        "tools": { "$ref": "#/definitions/toolsConfig" },
        "constraints": { "$ref": "#/definitions/constraintsConfig" }
      },
      "required": ["name", "description"],
      "additionalProperties": false
    },
    "agentDefaultsConfig": {
      "type": "object",
      "description": "Default values applied to all agents unless overridden. Does NOT require name or description.",
      "properties": {
        "mode": {
          "type": "string",
          "enum": ["all", "subagent"],
          "description": "Default agent mode."
        },
        "hidden": {
          "type": "boolean",
          "description": "Default hidden flag."
        },
        "model": {
          "type": "string",
          "description": "Default model override."
        },
        "triggers": {
          "type": "array",
          "description": "Default triggers (applied to all agents).",
          "items": { "type": "string" },
          "uniqueItems": true
        },
        "tags": {
          "type": "array",
          "description": "Default tags (applied to all agents).",
          "items": { "type": "string" },
          "uniqueItems": true
        },
        "permission": { "$ref": "#/definitions/permissionConfig" },
        "tools": { "$ref": "#/definitions/toolsConfig" },
        "constraints": { "$ref": "#/definitions/constraintsConfig" }
      },
      "additionalProperties": false
    },
    "permissionConfig": {
      "type": "object",
      "description": "Tool permission configuration.",
      "properties": {
        "read": { "enum": ["allow", "deny", "ask"], "description": "File read permission" },
        "write": { "enum": ["allow", "deny", "ask"], "description": "File write permission" },
        "edit": { "enum": ["allow", "deny", "ask"], "description": "File edit permission" },
        "glob": { "enum": ["allow", "deny", "ask"], "description": "Glob pattern matching" },
        "grep": { "enum": ["allow", "deny", "ask"], "description": "Content search" },
        "bash": { "enum": ["allow", "deny", "ask"], "description": "Shell command execution" },
        "task": { "enum": ["allow", "deny", "ask"], "description": "Task tool delegation" },
        "skill": { "enum": ["allow", "deny", "ask"], "description": "Skill loading" },
        "webfetch": { "enum": ["allow", "deny", "ask"], "description": "URL fetching" },
        "websearch": { "enum": ["allow", "deny", "ask"], "description": "Web search" },
        "external_directory": {
          "type": "object",
          "description": "Directory-specific access rules (pattern -> allow/deny/ask).",
          "additionalProperties": { "enum": ["allow", "deny", "ask"] }
        }
      },
      "additionalProperties": false
    },
    "toolsConfig": {
      "type": "object",
      "description": "MCP tool restrictions for this agent.",
      "properties": {
        "allowed": {
          "type": "array",
          "description": "MCP tool names this agent may use.",
          "items": { "type": "string" },
          "uniqueItems": true
        },
        "denied": {
          "type": "array",
          "description": "MCP tool names this agent may NOT use.",
          "items": { "type": "string" },
          "uniqueItems": true
        }
      },
      "additionalProperties": false
    },
    "constraintsConfig": {
      "type": "object",
      "description": "Operational constraints for this agent.",
      "properties": {
        "max_tokens_per_response": {
          "type": "integer",
          "minimum": 1,
          "description": "Maximum output tokens per response."
        },
        "budget": {
          "type": "object",
          "description": "Per-phase token budgets.",
          "additionalProperties": { "type": "integer", "minimum": 1 }
        },
        "light_mode_compatible": {
          "type": "boolean",
          "description": "Whether agent supports KODEHOLD_LIGHT=1."
        }
      },
      "additionalProperties": false
    }
  }
}
