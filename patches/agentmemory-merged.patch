# src-B8J9Exum.mjs (section 5) is the real runtime target. Both patches
# carry identical changes.
#
# Anvend:
#   sudo bash patches/agentmemory-merged.patch
#   systemctl --user restart agentmemory
#
# Rollback:
#   sudo bash patches/agentmemory-merged.patch --reverse
#   systemctl --user restart agentmemory

set -euo pipefail

MODE="${1:-apply}"

case "$MODE" in
  apply)   FLAGS="";;
  reverse|-R|--reverse) FLAGS="-R";;
  *) echo "Usage: $0 [--reverse]"; exit 1;;
