{
  "$schema": "https://opencode.ai/config.json",
  "model": "opencode-go/deepseek-v4-flash",
  "mcp": {
    "github": {
      "type": "local",
      "command": [
        "/home/kiffer/.local/bin/github-mcp-server",
        "stdio"
      ],
      "environment": {
        "GITHUB_PERSONAL_ACCESS_TOKEN": "{env:GITHUB_PERSONAL_ACCESS_TOKEN}"
      }
    },
    "chrome-devtools": {
      "type": "local",
      "command": [
        "npx",
        "-y",
        "chrome-devtools-mcp@latest",
        "--browser-url",
        "http://localhost:9222"
      ]
    },
    "opencode-mem": {
      "type": "local",
      "command": [
        "npx",
        "-y",
        "opencode-mem"
      ]
    }
  },
  "default_agent": "director",
  "provider": {
    "ollama": {
      "npm": "@ai-sdk/openai-compatible",
      "name": "Ollama (local)",
      "options": {
        "baseURL": "http://localhost:11434/v1"
      },
      "models": {
        "coder": {
          "name": "qwen2.5-coder:7b"
        },
        "llama3.1:8b": {
          "name": "llama3.1:8b"
        }
      }
    }
  },
  "compaction": {
    "auto": true,
    "prune": true,
    "reserved": 3000
  },
  "agent": {
    "director": {
      "description": "KodeHold Director \u2014 orchestrator that delegates tasks",
      "mode": "primary",
      "permission": {
        "read": "allow",
        "write": "deny",
        "edit": "deny",
        "glob": "allow",
        "grep": "allow",
        "bash": "allow",
        "task": "allow",
        "skill": "allow",
        "webfetch": "allow",
        "websearch": "allow",
        "external_directory": {
          "*": "ask",
          "/home/kiffer/project/**": "allow",
          "/tmp/**": "allow",
          "/home/kiffer/docker/**": "allow"
        }
      }
    }
  },
  "permission": {
    "bash": "allow",
    "external_directory": {
      "*": "ask",
      "/home/kiffer/project/**": "allow",
      "/tmp/**": "allow",
      "/home/kiffer/docker/**": "allow"
    }
  },
  "lsp": true,
  "plugin": [
    ".opencode/plugins/graphify.js"
  ]
}
