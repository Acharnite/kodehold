{
  "$schema": "https://opencode.ai/config.json",
  "default_agent": "director",
  "provider": {
    "ollama": {
      "npm": "@ai-sdk/openai-compatible",
      "name": "Ollama (local)",
      "options": {
        "baseURL": "http://localhost:11434/v1"
      },
      "models": {
        "qwen3:8b-opencode": {
          "name": "Qwen3 8B (local, 16K ctx)"
        }
      }
    }
  },
  "agent": {
    "plan": {
      "permission": {
        "read": "allow",
        "write": "allow",
        "edit": "allow",
        "glob": "allow",
        "grep": "allow",
        "bash": "allow",
        "list": "allow"
      }
    },
    "director": {
      "description": "KodeHold Director — orchestrator that delegates to specialist teams",
      "mode": "primary",
      "file": ".opencode/agents/director.md",
      "permission": {
        "read": "allow",
        "write": "allow",
        "edit": "allow",
        "glob": "allow",
        "grep": "allow",
        "bash": "allow",
        "task": "allow"
      }
    },
    "fls": {
      "description": "KodeHold FLS — Front Line Support, triage and hotfix",
      "file": ".opencode/agents/fls.md",
      "permission": {
        "read": "allow",
        "write": "allow",
        "edit": "allow",
        "glob": "allow",
        "grep": "allow",
        "bash": "allow"
      }
    }
  },
  "permission": {
    "bash": "allow",
    "external_directory": {
      "/home/kiffer/project/**": "allow",
      "/tmp/**": "allow",
      "*": "ask"
    }
  }
}
