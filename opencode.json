{
  "$schema": "https://opencode.ai/config.json",
  "mcp": {
    "github": {
      "type": "local",
      "command": ["/home/kiffer/.local/bin/github-mcp-server", "stdio"],
      "environment": {
        "GITHUB_PERSONAL_ACCESS_TOKEN": "{env:GITHUB_PERSONAL_ACCESS_TOKEN}"
      }
    }
  },
  "default_agent": "director",
  "provider": {
    "ollama": {
      "npm": "@ai-sdk/openai-compatible",
      "name": "Ollama (local)",
      "options": {
        "baseURL": "http://localhost:11434/v1"
      },
      "models": {
        "qwen3:8b-opencode": {
          "name": "Qwen3 8B (local, 16K ctx)"
        }
      }
    },
    "openrouter": {
      "npm": "@ai-sdk/openai-compatible",
      "name": "OpenRouter",
      "options": {
        "baseURL": "https://openrouter.ai/api/v1",
        "apiKey": "{env:OPENROUTER_API_KEY}"
      },
      "models": {
        "google/gemma-3-12b-it": {
          "name": "Gemma 3 12B",
          "attachment": false
        }
      }
    }
  },
  "compaction": {
    "auto": true,
    "prune": true,
    "reserved": 7000
  },
  "agent": {
    "plan": {
      "permission": {
        "read": "allow",
        "write": "allow",
        "edit": "allow",
        "glob": "allow",
        "grep": "allow",
        "bash": "allow",
        "list": "allow"
      }
    },
    "director": {
      "description": "KodeHold Director — orchestrator that delegates to specialist teams",
      "mode": "primary",
      "file": ".opencode/agents/director.md",
      "permission": {
        "read": "allow",
        "write": "deny",
        "edit": "deny",
        "glob": "allow",
        "grep": "allow",
        "bash": {
          "*": "ask",
          "scripts/gate.sh --status": "allow",
          "scripts/gate.sh --transition *": "allow",
          "scripts/workspace.sh *": "allow",
          "icm *": "allow",
          "git status*": "allow",
          "git log*": "allow",
          "git diff*": "allow"
        },
        "task": "allow",
        "skill": "allow",
        "webfetch": "allow",
        "websearch": "allow"
      }
    },
    "fls": {
      "description": "KodeHold FLS — Front Line Support, triage and hotfix",
      "file": ".opencode/agents/fls.md",
      "permission": {
        "read": "allow",
        "write": "allow",
        "edit": "allow",
        "glob": "allow",
        "grep": "allow",
        "bash": "allow"
      }
    }
  },
  "permission": {
    "bash": "allow",
    "external_directory": {
      "/home/kiffer/project/*": "allow",
      "/tmp/*": "allow",
      "*": "ask"
    }
  }
}
