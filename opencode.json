{
  "$schema": "https://opencode.ai/config.json",
  "model": "ollama/qwen3:8b-opencode",
  "provider": {
    "ollama": {
      "npm": "@ai-sdk/openai-compatible",
      "name": "Ollama (local)",
      "options": {
        "baseURL": "http://localhost:11434/v1"
      },
      "models": {
        "qwen3:8b-opencode": {
          "name": "Qwen3 8B (local, 16K ctx)"
        }
      }
    }
  },
  "agent": {
    "plan": {
      "permission": {
        "read": "allow",
        "write": "allow",
        "edit": "allow",
        "glob": "allow",
        "grep": "allow",
        "bash": "allow",
        "list": "allow"
      }
    }
  },
  "permission": {
    "bash": "allow",
    "external_directory": {
      "/home/kiffer/project/**": "allow",
      "/tmp/**": "allow",
      "*": "ask"
    }
  }
}
